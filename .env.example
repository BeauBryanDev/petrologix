# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# --- Geologist LLM (Anthropic) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# max_tokens caps thinking + answer together. Raise if answers still get cut;
# keep it under ~16000 while the client is non-streaming.
ANTHROPIC_MAX_TOKENS=4096
# true = adaptive thinking (better on hard questions, spends the same budget
# as the answer and adds latency). The reasoning is never shown to the user.
ANTHROPIC_THINKING=false

# --- Geologist LLM (Hugging Face Space — legacy) ---------------------------
# The Space is public, so a token is OPTIONAL. Set one anyway:
#   * authenticated calls use YOUR HF quota, not the shared anonymous pool
#   * required the moment the Space is made private
# Create at https://huggingface.co/settings/tokens with READ scope only.
HF_TOKEN=
HF_LLM_ENDPOINT=https://beaunix-aegis-geo-mind-demo.hf.space
HF_LLM_API_NAME=/respond

# --- Lithology model -------------------------------------------------------
# Leave unset to use the model bundled in the petrologix wheel.
# PETROLOGIX_MODELS_DIR=
MIN_INTERVAL_THICKNESS_M=0.5

# --- Market data (EIA) -----------------------------------------------------
# Spot prices for WTI (RWTC) and Brent (RBRTE). Free key, no approval step:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- App -------------------------------------------------------------------
DEBUG=false
MAX_UPLOAD_MB=50

# --- RAG (geology corpus) --------------------------------------------------
# Qdrant Cloud. The URL includes the port, e.g.
# https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=geo_corpus

# Query embeddings: BAAI/bge-large-en-v1.5, 1024 dimensions. MUST be the same
# model the collection was built with, and the endpoint must return one pooled
# sentence vector (not token-level output) -- startup checks the dimension but
# cannot check the model identity.
#   HF Inference Providers:
#   https://router.huggingface.co/hf-inference/models/BAAI/bge-large-en-v1.5/pipeline/feature-extraction
EMBEDDING_ENDPOINT=
# Falls back to HF_TOKEN when unset.
EMBEDDING_TOKEN=

# Retrieval. Threshold is cosine similarity; below ~0.5 bge returns unrelated
# text, which is worse than no context.
RAG_ENABLED=true
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5
